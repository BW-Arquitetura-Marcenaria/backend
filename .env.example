# ==========================================
# BANCO - DESENVOLVIMENTO
# ==========================================

DB_USER=bw_user
DB_PASSWORD=bw_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=bw_marcenaria

# ==========================================
# APLICAÇÃO
# ==========================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# INTEGRAÇÕES (n8n)
# ==========================================

# Chave enviada pelo n8n no header X-Api-Key.
# Gere uma nova no seu .env (veja o comando no README) e nunca commite o valor real.
INTEGRACAO_API_KEY=

# ==========================================
# SEGURANÇA (JWT)
# ==========================================

# Segredo usado para assinar os tokens de login (mínimo 32 bytes).
# Gere com: openssl rand -base64 48
# Nunca commite o valor real.
JWT_SECRET=

# ==========================================
# E-MAIL (convites de administradores)
# ==========================================

# Servidor SMTP usado pelo Spring Mail (JavaMail).
# Gmail: smtp.gmail.com / 587, com senha de app (nunca a senha da conta).
# Nunca commite os valores reais.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Endereço do front, usado para montar o link do convite enviado por e-mail.
APP_BASE_URL=http://localhost:8443

# ==========================================
# BANCO - TESTES
# ==========================================

TEST_DB_USER=bw_test
TEST_DB_PASSWORD=bw_test
TEST_DB_ROOT_PASSWORD=root_test_password
TEST_DB_DATABASE=bw_marcenaria_test

TEST_DB_URL=jdbc:mysql://localhost:3307/bw_marcenaria_test