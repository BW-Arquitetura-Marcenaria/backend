# ==========================================
# BANCO - DESENVOLVIMENTO
# ==========================================

DB_USER=bw_user
DB_PASSWORD=bw_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=bw_marcenaria

# ==========================================
# APLICAÇÃO
# ==========================================

SERVER_PORT=8081

# dev  = Swagger ligado (desenvolvimento)
# prod = Swagger desligado (produção)
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# INTEGRAÇÕES (n8n)
# ==========================================

# Chave enviada pelo n8n no header X-Api-Key.
# Gere uma nova no seu .env (veja o comando no README) e nunca commite o valor real.
INTEGRACAO_API_KEY=

# ==========================================
# SEGURANÇA (JWT)
# ==========================================

# Segredo usado para assinar os tokens de login (mínimo 32 bytes).
# Gere com: openssl rand -base64 48
# Nunca commite o valor real.
JWT_SECRET=

# ==========================================
# E-MAIL (convites de administradores e avisos do chat)
# ==========================================

# Servidor SMTP usado pelo Spring Mail (JavaMail).
# Gmail: smtp.gmail.com / 587, com senha de app (nunca a senha da conta).
# Nunca commite os valores reais.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Endereço do front, usado para montar os links enviados por e-mail
# (convite de administrador e avisos do chat).
APP_BASE_URL=http://localhost:8443

# ==========================================
# BANCO - TESTES
# ==========================================

TEST_DB_USER=bw_test
TEST_DB_PASSWORD=bw_test
TEST_DB_ROOT_PASSWORD=root_test_password
TEST_DB_DATABASE=bw_marcenaria_test

TEST_DB_URL=jdbc:mysql://localhost:3307/bw_marcenaria_test

# ==========================================
# API - GOOGLE CALENDAR
# ==========================================

GOOGLE_CLIENT_ID=seu-client-id
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=seu-redirect-uri
GOOGLE_TOKEN_ENCRYPTION_KEY="COLE_A_CHAVE_GERADA_AQUI"

# ==========================================
# API - CLICKSIGN (assinatura eletrônica de contratos)
# ==========================================

# https://sandbox.clicksign.com para testes (sem validade jurídica)
# https://app.clicksign.com em produção
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com

# Access token gerado no painel da Clicksign (Minha conta > Integrações de API).
# Enviado sem prefixo "Bearer". Nunca commite o valor real.
CLICKSIGN_ACCESS_TOKEN=

# Secret HMAC SHA-256 gerado ao cadastrar o webhook na Clicksign,
# usado para validar o cabeçalho Content-Hmac recebido em /v1/api/webhooks/clicksign.
# Nunca commite o valor real.
CLICKSIGN_WEBHOOK_SECRET=

# Método de autenticação exigido do signatário para assinar: email, sms, whatsapp, icp_brasil, etc.
CLICKSIGN_AUTH_METHOD=email